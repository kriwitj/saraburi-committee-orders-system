# Dockerfile.migrate
# รัน drizzle-kit push เพื่อ sync schema กับ database
# ใช้: docker compose run --rm migrate

FROM node:20-alpine
WORKDIR /app

# ติดตั้ง dependencies ทั้งหมด (รวม devDependencies สำหรับ drizzle-kit)
COPY package*.json ./
RUN npm ci

# copy source files ที่ drizzle-kit ต้องการ
COPY db/       ./db/
COPY drizzle.config.ts ./
COPY tsconfig.json ./

CMD ["npx", "drizzle-kit", "push", "--force"]
