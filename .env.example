# =============================================================
# SAROrders — ตัวอย่าง Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ถูกต้อง
# =============================================================

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string
# รูปแบบ: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# สำหรับ Docker Compose: ใช้ชื่อ service "db" แทน localhost
DATABASE_URL=postgresql://sarorders:changeme@localhost:5432/sarorders

# เปิด SSL สำหรับ PostgreSQL ที่อยู่บน cloud (Neon, RDS, etc.)
# ตั้งเป็น true ถ้าใช้ cloud database, false สำหรับ local/Docker
DATABASE_SSL=false

# ─── Authentication ──────────────────────────────────────────
# JWT Secret — ต้องสุ่มค่าที่ปลอดภัยและยาวพอ (อย่างน้อย 32 ตัวอักษร)
# สร้างด้วย: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret-string-here

# ─── File Storage ────────────────────────────────────────────
# โฟลเดอร์สำหรับเก็บไฟล์แนบ (absolute path)
# ถ้าไม่กำหนด จะใช้ ./uploads ใน project directory
# สำหรับ Docker: ให้ mount volume และกำหนด path ที่ต้องการ
UPLOAD_DIR=/var/www/sarorders/uploads

# ─── Application ─────────────────────────────────────────────
# URL ของแอปพลิเคชัน (ใช้สำหรับ redirect และ CORS)
NEXTAUTH_URL=http://localhost:3000