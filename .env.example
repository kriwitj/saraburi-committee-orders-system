# =============================================================
# SAROrders — Environment Variables
# cp .env.example .env  แล้วแก้ค่าทุกบรรทัดที่มี "changeme"
# =============================================================

# ─── Domain & Application ────────────────────────────────────
# Domain หลักของแอป (ไม่ใส่ https://)
DOMAIN=orders.saraburi.go.th

# URL เต็มของแอป (Traefik จะ inject https อัตโนมัติ)
NEXTAUTH_URL=https://orders.saraburi.go.th

# ─── Database ────────────────────────────────────────────────
# Password ของ PostgreSQL (Traefik Compose ใช้ค่านี้สร้าง DATABASE_URL ให้อัตโนมัติ)
# สร้างด้วย: openssl rand -base64 24
DB_PASSWORD=changeme

# (dev เท่านั้น) กรณีรัน Next.js ตรงโดยไม่ผ่าน Docker Compose
DATABASE_URL=postgresql://sarorders:changeme@localhost:5432/sarorders
DATABASE_SSL=false

# ─── Authentication ──────────────────────────────────────────
# JWT Secret — ต้องยาวอย่างน้อย 32 ตัวอักษร
# สร้างด้วย: openssl rand -base64 32
JWT_SECRET=changeme

# ─── Traefik / Let's Encrypt ─────────────────────────────────
# อีเมลสำหรับแจ้งเตือนจาก Let's Encrypt (SSL certificate หมดอายุ ฯลฯ)
ACME_EMAIL=admin@saraburi.go.th

# Basic Auth สำหรับ Traefik Dashboard (traefik.your-domain.com)
# ขั้นตอน:
#   1. sudo apt install apache2-utils
#   2. htpasswd -nbB admin 'yourpassword' | sed -e 's/\$/\$\$/g'
#   3. copy ผลที่ได้มาใส่ด้านล่าง
# หมายเหตุ: $ ใน docker-compose ต้องเขียนเป็น $$ จึงต้องใช้ sed แปลง
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$changethishashvalue

# ─── File Storage ────────────────────────────────────────────
# Docker Compose mount volume ให้อัตโนมัติ ไม่ต้องแก้บรรทัดนี้
# (ใช้สำหรับรัน Next.js ตรงนอก Docker เท่านั้น)
UPLOAD_DIR=./uploads